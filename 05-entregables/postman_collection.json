{
  "info": {
    "name": "Examen Tecnico IT - Compras y Ventas",
    "description": "Colección para probar los microservicios .NET 8. Ejecuta primero 'Login' para guardar el token automáticamente.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "authUrl", "value": "http://localhost:5001/api" },
    { "key": "comprasUrl", "value": "http://localhost:5002/api" },
    { "key": "ventasUrl", "value": "http://localhost:5003/api" },
    { "key": "movimientosUrl", "value": "http://localhost:5004/api" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "1. Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{authUrl}}/auth/login", "host": ["{{authUrl}}"], "path": ["auth", "login"] },
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}" }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const res = pm.response.json();",
              "if (res.success && res.data && res.data.token) {",
              "  pm.collectionVariables.set('token', res.data.token);",
              "  console.log('Token guardado.');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "2. Productos - Listar",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{comprasUrl}}/productos", "host": ["{{comprasUrl}}"], "path": ["productos"] }
      }
    },
    {
      "name": "3. Productos - Registrar",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{comprasUrl}}/productos", "host": ["{{comprasUrl}}"], "path": ["productos"] },
        "body": { "mode": "raw", "raw": "{\n  \"nombreProducto\": \"Monitor LG 24\",\n  \"nroLote\": \"LOTE-100\",\n  \"costo\": 350,\n  \"precioVenta\": 472.5\n}" }
      }
    },
    {
      "name": "4. Productos - Actualizar",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{comprasUrl}}/productos/1", "host": ["{{comprasUrl}}"], "path": ["productos", "1"] },
        "body": { "mode": "raw", "raw": "{\n  \"idProducto\": 1,\n  \"nombreProducto\": \"Laptop HP 240 G9 (actualizada)\",\n  \"nroLote\": \"LOTE-001\",\n  \"costo\": 1800,\n  \"precioVenta\": 2430\n}" }
      }
    },
    {
      "name": "5. Compras - Registrar",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{comprasUrl}}/compras", "host": ["{{comprasUrl}}"], "path": ["compras"] },
        "body": { "mode": "raw", "raw": "{\n  \"detalles\": [\n    { \"idProducto\": 1, \"cantidad\": 10, \"precio\": 1800 },\n    { \"idProducto\": 2, \"cantidad\": 20, \"precio\": 25 }\n  ]\n}" }
      }
    },
    {
      "name": "6. Compras - Listar",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{comprasUrl}}/compras", "host": ["{{comprasUrl}}"], "path": ["compras"] }
      }
    },
    {
      "name": "7. Ventas - Registrar",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": { "raw": "{{ventasUrl}}/ventas", "host": ["{{ventasUrl}}"], "path": ["ventas"] },
        "body": { "mode": "raw", "raw": "{\n  \"detalles\": [\n    { \"idProducto\": 1, \"cantidad\": 2 }\n  ]\n}" }
      }
    },
    {
      "name": "8. Ventas - Listar",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{ventasUrl}}/ventas", "host": ["{{ventasUrl}}"], "path": ["ventas"] }
      }
    },
    {
      "name": "9. Kardex - Listar",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{movimientosUrl}}/kardex", "host": ["{{movimientosUrl}}"], "path": ["kardex"] }
      }
    },
    {
      "name": "10. Kardex - Movimientos de un producto",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{movimientosUrl}}/kardex/1/movimientos", "host": ["{{movimientosUrl}}"], "path": ["kardex", "1", "movimientos"] }
      }
    }
  ]
}
